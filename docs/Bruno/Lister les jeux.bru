meta {
  name: Lister les jeux
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/games
  body: none
  auth: inherit
}

tests {
  test("Réponse 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("La réponse est un tableau JSON", function () {
    expect(res.getBody()).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
